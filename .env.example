# Copy to .env (which git ignores) and fill in. Never commit the real token.
# tunnel makes plain `docker compose up -d` start cloudflared too; empty it to run the page alone.
COMPOSE_PROFILES=tunnel
# From Cloudflare Zero Trust, Networks, Tunnels: the string after --token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=
# The image CI publishes for amd64 and arm64 (Raspberry Pi). Leave unset to build locally.
SITE_IMAGE=ghcr.io/kevinmcaleer/kevspowertools.com:latest
# Port on the host for http://localhost access.
SITE_PORT=8090
